<?xml version="1.0" encoding="UTF-8"?>
<!-- BETA build variant.
     ====================
     Byte-for-byte identical to manifest.xml except for two attributes:

       id   - a SEPARATE application id, so the beta installs ALONGSIDE the
              production app instead of replacing it. Connect IQ keys an
              installed app by its application id, and it scopes FIT developer
              data by that same id, so a ride recorded with both fields active
              carries two independently attributed copies of the schema below.
              That side-by-side attribution is the entire point of this file.
       name - "@Strings.AppNameBeta" so the two entries are distinguishable in
              the device's data-field picker.

     The FIT developer field ids stay 0-3, exactly as production
     (source/CarbBurnView.mc:127-134). Same schema under a different app id is
     what makes an A/B diff of one activity readable; renumbering here would
     make the two sets incomparable.

     The <iq:products> list MUST stay identical to manifest.xml - CI compiles
     this variant against the same 13-device matrix.

     This id is NOT registered on the Connect IQ Store and must never be
     submitted there. It exists for sideloading a beta next to the store build.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="CarbBurnApp"
                    id="3aa0137493fa4511ba559720835b1ab5"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.1.0"
                    name="@Strings.AppNameBeta"
                    type="datafield">
        <iq:products>
            <iq:product id="edge530"/>
            <iq:product id="edge830"/>
            <iq:product id="edge540"/>
            <iq:product id="edge840"/>
            <iq:product id="edge1030"/>
            <iq:product id="edge1030plus"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fr955"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
