# Connect IQ build artifacts
bin/
gen/
external-mir/
internal-mir/
*.prg
*.iq
*.debug.xml
*.mir
*.mcgen
*.mbc

# VS Code Monkey C per-project settings
*-settings.json

# Developer key (never commit private keys)
*.der
developer_key*

# Python bytecode. Prophylactic: nothing in scripts/ imports a local module
# today, and running a top-level script alone writes no __pycache__ - only an
# import (or py_compile) does. Kept so that stops being a trap later.
__pycache__/
*.pyc

# Scratch / temp
*.tmp
*.bak

# OS
Thumbs.db
.DS_Store
